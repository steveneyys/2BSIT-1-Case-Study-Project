# Copy this file to .env and fill in the values. NEVER commit .env.
# Supabase: Connect > Session pooler > URI (use this if the direct host fails with ENOTFOUND)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-X-REGION.pooler.supabase.com:5432/postgres
# Use false only for a local PostgreSQL without SSL
DATABASE_SSL=true
