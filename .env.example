# Copy to .env (never commit .env). Loaded automatically at startup.

PORT=3000
NODE_ENV=development

# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (URI).
# Replace [YOUR-PASSWORD]. If the password has special characters, URL-encode them.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-x.pooler.supabase.com:5432/postgres

# Supabase requires TLS. Set to false only for a local Postgres without SSL.
DB_SSL=true

# Used for sessions in S1-DEV-03. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Base URL used in emailed links. Use your real site address when deployed.
APP_URL=http://localhost:3000

# Email (optional). If SMTP_HOST is empty, reset links are printed in the server console instead.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Hope ERP <no-reply@example.com>
