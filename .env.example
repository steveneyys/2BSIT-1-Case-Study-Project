# Copy to .env (never commit .env). Loaded automatically at startup.

PORT=6543
NODE_ENV=development

# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (URI).
# Replace [YOUR-PASSWORD]. If the password has special characters, URL-encode them.
DATABASE_URL=postgresql://postgres.zahmlunlxzgeqesuqwrb:[passowrd]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_QBuv0KYxfGsjnkEln2cG3Q_ZMOwJDD4

# Supabase requires TLS. Set to false only for a local Postgres without SSL.
DB_SSL=true

# Used for sessions in S1-DEV-03. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-secret
